{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apexpulse-attendance",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apexpulse-attendance-db",
      "database_id": "37c37732-ed1f-4455-9154-328a8c85f1bc"
    }
  ]
}
